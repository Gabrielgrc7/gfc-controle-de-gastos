{
  "name": "gfc-controle-de-gastos",
  "version": "1.0.0",
  "description": "GFC: controle de gastos pessoal que roda no navegador, com dados só no aparelho.",
  "private": true,
  "scripts": {
    "sync": "node tools/build.js --sync",
    "build": "node tools/build.js",
    "build:single": "node tools/build.js --single",
    "test": "node tools/build.js --single && node tests/run-all.js",
    "serve": "npx serve dist",
    "format": "prettier --write \"src/js/**/*.js\" \"src/css/**/*.css\" \"tools/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/js/**/*.js\" \"src/css/**/*.css\" \"tools/**/*.js\" \"tests/**/*.js\"",
    "check:release": "node tools/build.js && node tools/check-release.js",
    "check:release:strict": "node tools/build.js && node tools/check-release.js --strict",
    "personalizar": "node tools/personalizar.js",
    "test:browser": "node tools/build.js && cd tests/browser && npm install --no-audit --no-fund --silent && node e2e.js"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^24.1.3",
    "pdfjs-dist": "3.11.174",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Gabriel Euflausino Garcia <gabrielgarciaez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabrielgrc7/gfc-controle-de-gastos.git"
  },
  "homepage": "https://Gabrielgrc7.github.io/gfc-controle-de-gastos",
  "bugs": {
    "url": "https://github.com/Gabrielgrc7/gfc-controle-de-gastos/issues"
  },
  "license": "MIT"
}
